// Defines the Dev Container service, startup and initialize scripts, editor settings, and extensions.
// It can also control the extensions which are installed into the vscode container and you can control the settings of those extensions.
// For example, this installs the C/C++ Extension, Python Extension. 
// Under customizations/vscode/settings you may control each settin. For example,
// the following defines what paths the python extension searchs for packages under:
// "python.analysis.extraPaths": [
//     "/opt/ros/jazzy/lib/python3.12/site-packages",
//     "${workspaceFolder}/ros_ws/install/px4_msgs/local/lib/python3.12/dist-packages",
//     "${workspaceFolder}/ros_ws/src"
// ]

{
    "name": "QADT Dev Container (PX4)",
    "dockerComposeFile": [
        "compose.base.yml",
        "compose.active.yml"
    ],
    "service": "dev",
    "overrideCommand": true,
    "workspaceFolder": "/home/qadt/AeroSAE2027",
    "remoteUser": "qadt",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true, // zsh terminal style will exist, but will only use bash
            "upgradePackages": false
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                // Python
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.autoSearchPaths": true,
                "python.analysis.useLibraryCodeForTypes": true,
                "python.analysis.typeCheckingMode": "basic",
                "python.analysis.extraPaths": [
                    "/opt/ros/jazzy/lib/python3.12/site-packages",
                    "${workspaceFolder}/ros_ws/install/px4_msgs/local/lib/python3.12/dist-packages",
                    "${workspaceFolder}/ros_ws/src"
                ],
                // C++
                "C_Cpp.default.includePath": [
                    "${workspaceFolder}/ros_ws/src/**",
                    "${workspaceFolder}/ros_ws/install/px4_msgs/include/**",
                    "/opt/ros/jazzy/include/**",
                    "/usr/include/**"
                ],
                "C_Cpp.default.browse.path": [
                    "${workspaceFolder}/ros_ws/src/**",
                    "${workspaceFolder}/ros_ws/install/px4_msgs/include/**",
                    "/opt/ros/jazzy/include/**"
                ],
                "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
                "C_Cpp.default.cStandard": "c17",
                "C_Cpp.default.cppStandard": "gnu++20",
                // clang-format support
                "editor.defaultFormatter": "xaver.clang-format",
                "editor.formatOnSave": true,
                "C_Cpp.formatting": "clangFormat",
                // For faster performance
                "remote.downloadExtensionsLocally": true
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools",
                "josetr.cmake-language-support-vscode",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "redhat.vscode-xml",
                "eamodio.gitlens",
                "xaver.clang-format"
            ]
        }
    },
    "initializeCommand": [
        "bash",
        "-lc",
        ".devcontainer/initialize.sh"
    ],
    "postStartCommand": [
        "bash",
        "-lc",
        ".devcontainer/postStart.sh"
    ],
    "shutdownAction": "stopCompose"
}
