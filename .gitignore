# Changes to files that will be ignored by git
# Uses glob pattern. Ex: '*.exe' ignores all files ending with '.exe'.
*.exe
*.bin
.devcontainer/compose.active.yml
.DS_Store
credentials.json
token.json

# Changes to folders that will be ignored by git.
# Format: [folder_name]/
.vscode/
install/
build/
log/

# Container-runtime artifacts that land in the workspace root instead of $HOME proper
# (VS Code Server's install/extensions, various tools' caches/config dirs). Harmless,
# but VS Code's Source Control panel expands untracked directories file-by-file rather
# than collapsing them like `git status` does - .vscode-server/ alone can be 10,000+
# files (extension bundles, language servers, icon assets), which is why "Source
# Control" can look broken/enormous even though `git status` itself looks fine.
.vscode-server/
.cache/
.copilot/
.claude/
.dotnet/
.gnupg/
.Xauthority
.gitconfig
.zcompdump
.devcontainer/.onCreateCommandMarker
.devcontainer/.postCreateCommandMarker
.devcontainer/.postStartCommandMarker
.devcontainer/.updateContentCommandMarker

# Perception
*.py[cod]
*.svo
*.svo2
*.area

__pycache__/
.pytest_cache/
test-output/
.tmp-tests/
perception/recordings/
perception/training_frames/
runs/