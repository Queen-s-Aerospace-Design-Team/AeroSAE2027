import numpy as np
import cv2 as cv
import glob
import os

# termination criteria
criteria = (cv.TERM_CRITERIA_EPS + cv.TERM_CRITERIA_MAX_ITER, 30, 0.001)

# prepare object points, like (0,0,0), (1,0,0), (2,0,0) ....,(6,5,0)
objp = np.zeros((6*9, 3), np.float32)
objp[:, :2] = np.mgrid[0:9, 0:6].T.reshape(-1, 2)

# Arrays to store object points and image points from all the images.
objpoints = []  # 3d point in real world space
imgpoints = []  # 2d points in image plane.

script_dir = os.path.dirname(os.path.abspath(__file__))
images = glob.glob(os.path.join(script_dir, 'imgs/*.png'))

for fname in images:
    img = cv.imread(fname)  # Put image into a dataframe sturucture
    gray = cv.cvtColor(img, cv.COLOR_BGR2GRAY)  # Remove color (gray scale)

    # Find the chess board corners
    # Corners = list of pixel coordinates for each inner corner of the chessboard
    ret, corners = cv.findChessboardCorners(gray, (9, 6), None)

    # If found, add object points, image points (after refining them)
    if ret == True:
        # Holds the 3D coordinates of the corners in real world space (measured in units of chessboard squares)
        objpoints.append(objp)

        # Finds subpixel accurate corner locations
        corners2 = cv.cornerSubPix(gray, corners, (11, 11), (-1, -1), criteria)
        # Holds the 2D coordinates of the corners in image space (measured in pixels)
        imgpoints.append(corners2)

        # Draw and display the corners
        cv.drawChessboardCorners(img, (9, 6), corners2, ret)
        cv.imshow('img', img)
        cv.waitKey(0)

    else:
        print("Chessboard corners not found in image: {}".format(fname))

cv.destroyAllWindows()

# Calibrate the camera
ret, mtx, dist, rvecs, tvecs = cv.calibrateCamera(
    objpoints, imgpoints, gray.shape[::-1], None, None)

img = cv.imread('IMG_5630.png')
h, w = img.shape[:2]
newcameramtx, roi = cv.getOptimalNewCameraMatrix(mtx, dist, (w, h), 1, (w, h))

# Undistort the image
dst = cv.undistort(img, mtx, dist, None, newcameramtx)

# crop the image
x, y, w, h = roi
dst = dst[y:y+h, x:x+w]
cv.imwrite('calibresult.png', dst)

mean_error = 0
for i in range(len(objpoints)):
    imgpoints2, _ = cv.projectPoints(objpoints[i], rvecs[i], tvecs[i], mtx, dist)
    pts_detected = imgpoints[i].reshape(-1, 2)
    pts_projected = imgpoints2.reshape(-1, 2)
    error = cv.norm(pts_detected, pts_projected, cv.NORM_L2) / len(pts_projected)
    mean_error += error

print("total error: {}".format(mean_error / len(objpoints)))
